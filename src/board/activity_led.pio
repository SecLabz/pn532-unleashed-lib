; WS2812 status LED waveform.
.program activity_led
.side_set 1
.define public T1 2
.define public T2 5
.define public T3 3
.wrap_target
bitloop:
    out x, 1       side 0 [T3 - 1]
    jmp !x do_zero side 1 [T1 - 1]
    jmp bitloop    side 1 [T2 - 1]
do_zero:
    nop            side 0 [T2 - 1]
.wrap

% c-sdk {
#include "hardware/clocks.h"

static inline void activity_led_program_init(PIO pio, uint sm, uint offset,
                                            uint pin)
{
    pio_gpio_init(pio, pin);
    pio_sm_set_consecutive_pindirs(pio, sm, pin, 1u, true);
    pio_sm_config config = activity_led_program_get_default_config(offset);
    sm_config_set_sideset_pins(&config, pin);
    sm_config_set_out_shift(&config, false, true, 24u);
    sm_config_set_fifo_join(&config, PIO_FIFO_JOIN_TX);
    sm_config_set_clkdiv(&config, (float)clock_get_hz(clk_sys) / 8000000.0f);
    pio_sm_init(pio, sm, offset, &config);
    pio_sm_set_enabled(pio, sm, true);
}
%}
